# Copy this file to .env and fill in your own values.
# .env is gitignored; this file is committed.

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# Connection pool. All values are integers.
# These are optional - database.provider.ts falls back to the defaults shown here.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000




# JWT SECRETS
JWT_ACCESS_SECRET=<Your secret key>


# SMTP SETUP
SMTP_HOST=smtp.example.com
SMTP_USER=example@gmail.com
SMTP_PASSWORD=your app password
SMTP_PORT=465
APP_URL=http://localhost:3000
